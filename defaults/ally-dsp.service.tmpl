# Ally DSP filter chain in its own PipeWire process. Installed to
# ~/.config/systemd/user/ally-dsp.service with paths filled in by the plugin.
[Unit]
Description=Ally DSP speaker filter chain (Dolby tuning for ASUS ROG Ally handhelds)
After=pipewire.service wireplumber.service
BindsTo=pipewire.service
ConditionPathExists={conf_path}

[Service]
Type=simple
Environment="LV2_PATH={lv2_path}:/usr/lib/lv2"
Environment=MALLOC_ARENA_MAX=1
ExecStart=/usr/bin/pipewire -c "{conf_path}"
Restart=on-failure
RestartSec=1
LimitMEMLOCK=102400K
Slice=session.slice

[Install]
WantedBy=default.target
